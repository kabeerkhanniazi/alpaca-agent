# Alpaca paper-trading credentials.
# Create at https://alpaca.markets → Paper Trading → API Keys.
# Options Level 3 must be enabled on the account for vertical spreads.
#
# These are read directly by Alpaca's CLI, which this project uses as its
# transport. No `alpaca profile login` is required and nothing is written to
# disk, which is what keeps the scheduled cron run working.
ALPACA_API_KEY=...........................
ALPACA_SECRET_KEY=..........................

# Set to false only for a live-money account. Default is paper.
ALPACA_PAPER=true
